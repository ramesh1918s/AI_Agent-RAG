# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=infra-ai-agent
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- AWS (prefer IAM role / SSO profile over static keys) ---
AWS_REGION=ap-south-1
AWS_PROFILE=default

# --- Vector DB (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=terraform_docs
EMBEDDING_DIM=384

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64

# --- LLM / Agent ---
LLM_PROVIDER=bedrock
LLM_MODEL_ID=anthropic.claude-sonnet-4-6-v1:0
LLM_TEMPERATURE=0.1
AGENT_MAX_ITERATIONS=15
REQUIRE_HUMAN_APPROVAL_FOR_APPLY=true
REQUIRE_HUMAN_APPROVAL_FOR_DESTROY=true

# --- Terraform Engine ---
TERRAFORM_WORKSPACE_ROOT=./terraform-engine/workspaces
TERRAFORM_BINARY=terraform
TERRAFORM_DEFAULT_WORKSPACE=default

# --- Notifications ---
SNS_TOPIC_ARN=
SLACK_WEBHOOK_URL=

# --- Observability ---
OTEL_EXPORTER_ENDPOINT=
ENABLE_PROMETHEUS_METRICS=true
